{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(exclude)docs/' ':(exclude)exports/' ':(exclude)*.md'",
  "crons": [
    {
      "path": "/api/cron/orchestrate",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/integration-outbox",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/integration-sync",
      "schedule": "0 */6 * * *"
    }
  ]
}
